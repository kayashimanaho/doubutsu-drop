<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <radialGradient id="bg" cx="50%" cy="45%" r="70%">
      <stop offset="0%" stop-color="#3b1f8c"/>
      <stop offset="100%" stop-color="#0e0825"/>
    </radialGradient>
    <radialGradient id="glow1" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#a855f7" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#a855f7" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow2" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#7c3aed" stop-opacity="0"/>
    </radialGradient>
    <filter id="blur1">
      <feGaussianBlur stdDeviation="40"/>
    </filter>
    <filter id="textglow">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>

  <!-- Glow blobs -->
  <ellipse cx="300" cy="200" rx="300" ry="220" fill="url(#glow1)" filter="url(#blur1)"/>
  <ellipse cx="900" cy="430" rx="280" ry="200" fill="url(#glow2)" filter="url(#blur1)"/>

  <!-- Stars -->
  <g fill="white" opacity="0.5">
    <circle cx="80" cy="60" r="1.5"/>
    <circle cx="200" cy="120" r="1"/>
    <circle cx="350" cy="40" r="2"/>
    <circle cx="500" cy="90" r="1.5"/>
    <circle cx="700" cy="30" r="1"/>
    <circle cx="850" cy="80" r="2"/>
    <circle cx="1050" cy="50" r="1.5"/>
    <circle cx="1150" cy="110" r="1"/>
    <circle cx="120" cy="300" r="1"/>
    <circle cx="1100" cy="250" r="1.5"/>
    <circle cx="60" cy="500" r="2"/>
    <circle cx="1160" cy="480" r="1"/>
    <circle cx="400" cy="580" r="1.5"/>
    <circle cx="900" cy="560" r="1"/>
    <circle cx="1050" cy="600" r="1.5"/>
    <circle cx="250" cy="560" r="1"/>
  </g>
  <g fill="white" opacity="0.8">
    <circle cx="150" cy="180" r="1"/>
    <circle cx="600" cy="55" r="1.5"/>
    <circle cx="980" cy="140" r="1"/>
    <circle cx="1120" cy="340" r="1.5"/>
    <circle cx="30" cy="400" r="1"/>
  </g>

  <!-- Decorative ring -->
  <circle cx="600" cy="280" r="220" fill="none" stroke="#a855f7" stroke-width="1" opacity="0.12"/>
  <circle cx="600" cy="280" r="260" fill="none" stroke="#7c3aed" stroke-width="1" opacity="0.08"/>

  <!-- Animals arc (top) -->
  <text x="168" y="178" font-size="62" text-anchor="middle" opacity="0.85">🐣</text>
  <text x="278" y="118" font-size="62" text-anchor="middle" opacity="0.85">🐰</text>
  <text x="408" y="78" font-size="62" text-anchor="middle" opacity="0.85">🐱</text>
  <text x="548" y="62" font-size="62" text-anchor="middle" opacity="0.85">🐶</text>
  <text x="692" y="68" font-size="62" text-anchor="middle" opacity="0.85">🐨</text>
  <text x="826" y="96" font-size="62" text-anchor="middle" opacity="0.85">🐼</text>
  <text x="944" y="148" font-size="62" text-anchor="middle" opacity="0.85">🦁</text>
  <text x="1036" y="220" font-size="62" text-anchor="middle" opacity="0.85">🐘</text>

  <!-- Arrow hints between animals -->
  <g fill="#c084fc" opacity="0.4" font-size="18" font-family="sans-serif">
    <text x="226" y="104" text-anchor="middle">→</text>
    <text x="346" y="80" text-anchor="middle">→</text>
    <text x="480" y="62" text-anchor="middle">→</text>
    <text x="622" y="56" text-anchor="middle">→</text>
    <text x="760" y="66" text-anchor="middle">→</text>
    <text x="887" y="108" text-anchor="middle">→</text>
    <text x="993" y="170" text-anchor="middle">→</text>
  </g>

  <!-- Dragon highlight -->
  <circle cx="600" cy="370" r="90" fill="#7c3aed" opacity="0.18"/>
  <text x="600" y="408" font-size="110" text-anchor="middle" filter="url(#textglow)">🐉</text>

  <!-- Spark effects around dragon -->
  <g fill="#f0abfc" opacity="0.7">
    <polygon points="520,300 524,312 536,312 527,320 530,332 520,325 510,332 513,320 504,312 516,312" />
    <polygon points="682,298 685,307 694,307 687,313 689,322 682,317 675,322 677,313 670,307 679,307" />
    <polygon points="530,440 533,449 542,449 535,455 537,464 530,459 523,464 525,455 518,449 527,449" />
    <polygon points="672,442 675,451 684,451 677,457 679,466 672,461 665,466 667,457 660,451 669,451" />
  </g>

  <!-- Main title -->
  <text x="600" y="520" font-size="72" font-weight="bold" font-family="'Hiragino Sans', 'Yu Gothic', sans-serif" fill="white" text-anchor="middle" filter="url(#textglow)" letter-spacing="4">どうぶつドロップ</text>

  <!-- Purple underline -->
  <rect x="340" y="533" width="520" height="3" rx="2" fill="#a855f7" opacity="0.7"/>

  <!-- Subtitle -->
  <text x="600" y="582" font-size="26" font-family="'Hiragino Sans', 'Yu Gothic', sans-serif" fill="#c084fc" text-anchor="middle" opacity="0.9" letter-spacing="2">ひよこからドラゴンへ — 合体パズルゲーム</text>

  <!-- URL -->
  <text x="600" y="618" font-size="18" font-family="'Courier New', monospace" fill="rgba(255,255,255,0.35)" text-anchor="middle" letter-spacing="1">doubutsu-drop.com</text>
</svg>
